# Copy to .env, fill in, chmod 600. Keys only — never commit values.

# --- environment ---
# prod | dev | test (defaults to prod, the strictest)
APP_ENV=
# compose project name; one deployment = one company (white-label)
COMPOSE_PROJECT_NAME=

# --- postgres (compose provisions the container with these) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- application ---
# postgresql+asyncpg://user:password@postgres:5432/dbname
DATABASE_URL=
# redis://redis:6379/0
REDIS_URL=
# Fernet key for encrypting the TOTP secret at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Exact origins, comma-separated, e.g. https://bot.example.kz
CORS_ORIGINS=
# true until production acceptance (messages processed, nothing sent)
DRY_RUN=
LOG_LEVEL=

# --- GREEN-API transport (leave both empty to disable polling) ---
# Instance id from the GREEN-API console, e.g. 1101123456
GREEN_API_ID_INSTANCE=
# API token of that instance (secret)
GREEN_API_TOKEN=
# --- OpenAI (embeddings from phase 5, chat from phase 6) ---
# Use a DEDICATED OpenAI project with a hard spend limit (see README)
OPENAI_API_KEY=
# Optional model overrides (defaults are sane):
# OPENAI_EMBEDDING_MODEL=
# OPENAI_CHAT_MODEL=

# Optional GREEN-API overrides (sane defaults exist):
# GREEN_API_BASE_URL=
# GREEN_API_RECEIVE_TIMEOUT=

# --- media (phase 7) ---
# Каталог тома с медиа внутри контейнера (в compose это том wabot_media).
MEDIA_DIR=/data/media
MEDIA_DOWNLOAD_TIMEOUT=30
# Хосты, с которых разрешено скачивать входящие файлы (защита от SSRF:
# URL приходит из недоверенного payload, а воркер в одной сети с БД).
MEDIA_DOWNLOAD_HOSTS=green-api.com,greenapi.com
# Модель распознавания речи (цена — за минуту аудио, см. «Лимиты»).
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
